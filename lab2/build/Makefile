	$(MAKE) $(MAKESILENT) -f CMakeFiles/client_mmap.dir/build.make CMakeFiles/client_mmap.dir/src/wolf_game.cpp.o
	$(MAKE) $(MAKESILENT) -f CMakeFiles/host_shm.dir/build.make CMakeFiles/host_shm.dir/src/wolf_game.cpp.o
	$(MAKE) $(MAKESILENT) -f CMakeFiles/client_shm.dir/build.make CMakeFiles/client_shm.dir/src/wolf_game.cpp.o
.PHONY : src/wolf_game.cpp.o

src/wolf_game.i: src/wolf_game.cpp.i
.PHONY : src/wolf_game.i

# target to preprocess a source file
src/wolf_game.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/host_fifo.dir/build.make CMakeFiles/host_fifo.dir/src/wolf_game.cpp.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/client_fifo.dir/build.make CMakeFiles/client_fifo.dir/src/wolf_game.cpp.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/host_mmap.dir/build.make CMakeFiles/host_mmap.dir/src/wolf_game.cpp.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/client_mmap.dir/build.make CMakeFiles/client_mmap.dir/src/wolf_game.cpp.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/host_shm.dir/build.make CMakeFiles/host_shm.dir/src/wolf_game.cpp.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/client_shm.dir/build.make CMakeFiles/client_shm.dir/src/wolf_game.cpp.i
.PHONY : src/wolf_game.cpp.i

src/wolf_game.s: src/wolf_game.cpp.s
.PHONY : src/wolf_game.s

# target to generate assembly for a file
src/wolf_game.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/host_fifo.dir/build.make CMakeFiles/host_fifo.dir/src/wolf_game.cpp.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles/client_fifo.dir/build.make CMakeFiles/client_fifo.dir/src/wolf_game.cpp.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles/host_mmap.dir/build.make CMakeFiles/host_mmap.dir/src/wolf_game.cpp.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles/client_mmap.dir/build.make CMakeFiles/client_mmap.dir/src/wolf_game.cpp.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles/host_shm.dir/build.make CMakeFiles/host_shm.dir/src/wolf_game.cpp.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles/client_shm.dir/build.make CMakeFiles/client_shm.dir/src/wolf_game.cpp.s
.PHONY : src/wolf_game.cpp.s

